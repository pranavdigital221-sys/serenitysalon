# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Appointment Admin Notification Email
ADMIN_NOTIFICATION_EMAIL="pranavdigital221@gmail.com"

# Salon WhatsApp & Reception Contact
SALON_ADMIN_PHONE="+91 8108765851"

# Admin Authentication
ADMIN_EMAIL="admin@serenitysalon.com"
ADMIN_PASSWORD="Serenity@2026"
VITE_ADMIN_EMAIL="admin@serenitysalon.com"

# Razorpay Payment Gateway (Optional - Sandbox fallback active when keys not set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional SMTP Email Configuration (If not provided, automated logs & persistent audit entries are generated)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Serenity Salon Appointments <appointments@serenitysalon.in>"

# EmailJS Configuration (Client-side Email Dispatch)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
